# Copy to .env.local and fill in. Do NOT commit real keys.
# Server-only keys must NOT use the NEXT_PUBLIC_ prefix.

# --- Voice assistant (OpenAI Realtime + expert reasoner) ---
# Server-only. Powers /api/openai/realtime-token and /api/openai/rp-expert.
# Without it, the voice assistant shows a "not configured yet" state.
OPENAI_API_KEY=

# --- Donations (Stripe) ---
STRIPE_SECRET_KEY=

# --- Supabase (planned) ---
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Events (Wix Events) ---
# Wix stays the source of truth for events and registrations. Both are
# server-only: Wix's events read and RSVP-write scopes are NOT visitor-safe.
# API key: https://manage.wix.com/account/api-keys (scope it to the RP Hope site)
# Site ID: from the Wix site dashboard URL, after /dashboard/
WIX_API_KEY=
WIX_SITE_ID=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI-assisted curation for My RP Pathway (future) ---
# Bounded to RP Hope's reviewed content library; never generates medical claims.
ANTHROPIC_API_KEY=

# --- Gene page draft generation (npm run gene-pages:draft) ---
# Optional. Raises the NCBI E-utilities rate limit from 3 to 10 req/sec.
# Get one free at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
